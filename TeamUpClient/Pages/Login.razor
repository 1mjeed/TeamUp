@page "/login"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-8 rounded-lg" Style="width: 100%;">
        <MudCardHeader Class="d-flex justify-center pb-0">
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Style="font-weight: bold;">TeamUp</MudText>
                <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mt-2">تسجيل الدخول للنظام</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudTextField @bind-Value="loginRequest.Email" Label="البريد الإلكتروني" Variant="Variant.Outlined" Margin="Margin.Normal" Required="true" />
            <MudTextField @bind-Value="loginRequest.Password" Label="كلمة المرور" Variant="Variant.Outlined" InputType="InputType.Password" Margin="Margin.Normal" Required="true" />
        </MudCardContent>

        <MudCardActions Class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="ExecuteLogin" Disabled="isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudText>دخول</MudText>
                }
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private LoginRequestDto loginRequest = new();
    private bool isLoading = false;

    private async Task ExecuteLogin()
    {
        isLoading = true;
        try
        {
            // إرسال الطلب إلى الـ API الخاص بك
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();

                if (result != null)
                {
                    // تخزين التوكن في المتصفح لاستخدامه في الطلبات القادمة
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);

                    Snackbar.Add($"أهلاً بك يا {result.Name}", Severity.Success);
                    NavManager.NavigateTo("/"); // التوجيه للصفحة الرئيسية بعد النجاح
                }
            }
            else
            {
                // معالجة خطأ 401 الذي برمجته في الباك إند
                Snackbar.Add("البريد الإلكتروني أو كلمة المرور غير صحيحة", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("حدث خطأ في الاتصال بالخادم، تأكد من تشغيل الـ API.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    // تم وضع الـ DTOs هنا مؤقتاً لتسهيل النسخ، يمكنك نقلها لمجلد منفصل في الفرونت إند
    public class LoginRequestDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class AuthResponseDto
    {
        public string Token { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
}